# Production Environment Configuration
ENV=production
DEBUG=false

# Application
HOST=0.0.0.0
PORT=8000

# Security & JWT Auth
JWT_SECRET=aml-ledger-trace-production-secret-key-32-chars-long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Compliance Detection Defaults
STRUCTURING_THRESHOLD=10000.0
STRUCTURING_FLOOR=8500.0
MAX_CYCLE_LENGTH=5
FAN_IN_MIN_DEGREE=4
FAN_OUT_MIN_DEGREE=4
LAYERING_MAX_HOURS=12.0

# Database
DATABASE_URL=sqlite:///data/aml_database.db
