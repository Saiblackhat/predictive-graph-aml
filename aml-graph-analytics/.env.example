# Example Environment Configuration
ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

JWT_SECRET=replace-with-your-custom-jwt-secret-key-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

STRUCTURING_THRESHOLD=10000.0
STRUCTURING_FLOOR=8500.0
MAX_CYCLE_LENGTH=5
FAN_IN_MIN_DEGREE=4
FAN_OUT_MIN_DEGREE=4
LAYERING_MAX_HOURS=12.0

DATABASE_URL=sqlite:///data/aml_database.db
